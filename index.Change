import type { CustomFormulaSpec, DrawRecord, FormulaDefinition } from '../types/lottery';
import { STOCK_MARKETS } from '../data/markets';
import { createFormulaFromSpec } from './formulas';

const CUSTOM_DRAWS_STORAGE_KEY = 'intl_stock_lotto_draws_v1';
const CUSTOM_FORMULAS_STORAGE_KEY = 'intl_stock_lotto_formulas_v1';

export interface StoredCustomFormula {
  id: string;
  name: string;
  summary: string;
  spec: CustomFormulaSpec;
}

export function loadMarketHistories(): Record<string, DrawRecord[]> {
  const baseline: Record<string, DrawRecord[]> = {};
  for (const market of STOCK_MARKETS) {
    baseline[market.id] = [...market.defaultHistory];
  }

  if (typeof window === 'undefined') {
    return baseline;
  }

  try {
    const raw = window.localStorage.getItem(CUSTOM_DRAWS_STORAGE_KEY);
    if (!raw) return baseline;
    const parsed = JSON.parse(raw) as Record<string, DrawRecord[]>;
    if (parsed && typeof parsed === 'object') {
      for (const market of STOCK_MARKETS) {
        if (Array.isArray(parsed[market.id])) {
          baseline[market.id] = parsed[market.id];
        }
      }
    }
    return baseline;
  } catch {
    return baseline;
  }
}

export function saveMarketHistories(histories: Record<string, DrawRecord[]>): void {
  if (typeof window === 'undefined') return;
  try {
    window.localStorage.setItem(CUSTOM_DRAWS_STORAGE_KEY, JSON.stringify(histories));
  } catch {
    // Ignore storage quota errors
  }
}

export function loadCustomFormulas(): FormulaDefinition[] {
  if (typeof window === 'undefined') return [];
  try {
    const raw = window.localStorage.getItem(CUSTOM_FORMULAS_STORAGE_KEY);
    if (!raw) return [];
    const parsed = JSON.parse(raw) as StoredCustomFormula[];
    if (!Array.isArray(parsed)) return [];
    return parsed
      .filter((item) => item && item.id && item.name && item.spec)
      .map((item) =>
        createFormulaFromSpec(item.id, item.name, item.summary || '', item.spec, true)
      );
  } catch {
    return [];
  }
}

export function saveCustomFormulas(formulas: FormulaDefinition[]): void {
  if (typeof window === 'undefined') return;
  try {
    const serializable: StoredCustomFormula[] = formulas
      .filter((f) => f.isCustom && f.customSpec)
      .map((f) => ({
        id: f.id,
        name: f.name,
        summary: f.summary,
        spec: f.customSpec!,
      }));
    window.localStorage.setItem(CUSTOM_FORMULAS_STORAGE_KEY, JSON.stringify(serializable));
  } catch {
    // Ignore storage quota errors
  }
}
import type { DrawRecord, StockMarket } from '../types/lottery';

export const BANGKOK_OFFSET_MS = 7 * 60 * 60 * 1000;

export interface BangkokTimeParts {
  year: number;
  month: number; // 1-12
  day: number; // 1-31
  dayOfWeek: number; // 0 (Sun) - 6 (Sat)
  hour: number;
  minute: number;
  minutesOfDay: number;
  dateStr: string; // YYYY-MM-DD
  timeStr: string; // HH:MM
}

export type RoundPhase = 'pre_close_1h' | 'after_close' | 'waiting';

export interface MarketRoundSchedule {
  phase: RoundPhase;
  minutesUntilClose: number;
  targetDateStr: string;
  nextRoundLabelTh: string;
  isPreCloseWindow: boolean;
  hasClosedToday: boolean;
}

function pad2(n: number): string {
  return String(n).padStart(2, '0');
}

export function formatYmd(year: number, month: number, day: number): string {
  return `${year}-${pad2(month)}-${pad2(day)}`;
}

export function getBangkokParts(nowMs: number): BangkokTimeParts {
  const bkk = new Date(nowMs + BANGKOK_OFFSET_MS);
  const year = bkk.getUTCFullYear();
  const month = bkk.getUTCMonth() + 1;
  const day = bkk.getUTCDate();
  const dayOfWeek = bkk.getUTCDay();
  const hour = bkk.getUTCHours();
  const minute = bkk.getUTCMinutes();
  return {
    year,
    month,
    day,
    dayOfWeek,
    hour,
    minute,
    minutesOfDay: hour * 60 + minute,
    dateStr: formatYmd(year, month, day),
    timeStr: `${pad2(hour)}:${pad2(minute)}`,
  };
}

export function getBangkokTimestampMs(
  year: number,
  month: number,
  day: number,
  hour: number,
  minute: number
): number {
  return Date.UTC(year, month - 1, day, hour, minute) - BANGKOK_OFFSET_MS;
}

function addDaysYmd(
  year: number,
  month: number,
  day: number,
  deltaDays: number
): { year: number; month: number; day: number; dayOfWeek: number; dateStr: string } {
  const dt = new Date(Date.UTC(year, month - 1, day + deltaDays));
  const y = dt.getUTCFullYear();
  const m = dt.getUTCMonth() + 1;
  const d = dt.getUTCDate();
  return {
    year: y,
    month: m,
    day: d,
    dayOfWeek: dt.getUTCDay(),
    dateStr: formatYmd(y, m, d),
  };
}

export function parseCloseTime(closeTimeTh: string): {
  hour: number;
  minute: number;
  minutesOfDay: number;
  timeStr: string;
} {
  const match = closeTimeTh.match(/(\d{1,2}):(\d{2})/);
  const hour = match ? Number(match[1]) : 16;
  const minute = match ? Number(match[2]) : 0;
  return {
    hour,
    minute,
    minutesOfDay: hour * 60 + minute,
    timeStr: `${pad2(hour)}:${pad2(minute)}`,
  };
}

export function getMarketRoundSchedule(
  market: StockMarket,
  latestDraw: DrawRecord | undefined,
  nowMs: number = Date.now()
): MarketRoundSchedule {
  const now = getBangkokParts(nowMs);
  const close = parseCloseTime(market.closeTimeTh);
  const tomorrow = addDaysYmd(now.year, now.month, now.day, 1);

  let targetY = now.year;
  let targetM = now.month;
  let targetD = now.day;
  let hasClosedToday = false;

  if (market.region === 'thai') {
    const isDrawDay = now.day === 1 || now.day === 16;
    hasClosedToday = isDrawDay && now.minutesOfDay >= close.minutesOfDay;

    if (now.day === 1 && now.minutesOfDay < close.minutesOfDay) {
      targetD = 1;
    } else if (now.day < 16 || (now.day === 16 && now.minutesOfDay < close.minutesOfDay)) {
      targetD = 16;
    } else {
      targetM = now.month === 12 ? 1 : now.month + 1;
      targetY = now.month === 12 ? now.year + 1 : now.year;
      targetD = 1;
    }
  } else if (close.minutesOfDay < 360) {
    const isSessionDay = now.dayOfWeek >= 2 && now.dayOfWeek <= 6;
    hasClosedToday = isSessionDay && now.minutesOfDay >= close.minutesOfDay;

    if (isSessionDay && now.minutesOfDay < close.minutesOfDay) {
      // Today's 04:00 close hasn't happened yet
    } else {
      let delta = 1;
      while (delta <= 4) {
        const next = addDaysYmd(now.year, now.month, now.day, delta);
        if (next.dayOfWeek >= 2 && next.dayOfWeek <= 6) {
          targetY = next.year;
          targetM = next.month;
          targetD = next.day;
          break;
        }
        delta++;
      }
    }
  } else {
    const isTradingWeekday = now.dayOfWeek >= 1 && now.dayOfWeek <= 5;
    hasClosedToday = isTradingWeekday && now.minutesOfDay >= close.minutesOfDay;

    if (isTradingWeekday && now.minutesOfDay < close.minutesOfDay) {
      // Today's close hasn't happened yet
    } else {
      let delta = 1;
      while (delta <= 4) {
        const next = addDaysYmd(now.year, now.month, now.day, delta);
        if (next.dayOfWeek >= 1 && next.dayOfWeek <= 5) {
          targetY = next.year;
          targetM = next.month;
          targetD = next.day;
          break;
        }
        delta++;
      }
    }
  }

  const targetDateStr = formatYmd(targetY, targetM, targetD);
  const targetMs = getBangkokTimestampMs(
    targetY,
    targetM,
    targetD,
    close.hour,
    close.minute
  );
  const minutesUntilClose = Math.max(0, Math.ceil((targetMs - nowMs) / 60000));
  const isPreCloseWindow = minutesUntilClose > 0 && minutesUntilClose <= 60;

  let nextRoundLabelTh: string;
  if (targetDateStr === now.dateStr) {
    nextRoundLabelTh = `วันนี้ ${close.timeStr} น.`;
  } else if (targetDateStr === tomorrow.dateStr) {
    nextRoundLabelTh = `พรุ่งนี้ ${close.timeStr} น.`;
  } else {
    nextRoundLabelTh = `${targetDateStr} ${close.timeStr} น.`;
  }

  const alreadyRecordedToday = latestDraw?.date === now.dateStr;
  const phase: RoundPhase = isPreCloseWindow
    ? 'pre_close_1h'
    : hasClosedToday || alreadyRecordedToday
    ? 'after_close'
    : 'waiting';

  return {
    phase,
    minutesUntilClose,
    targetDateStr,
    nextRoundLabelTh,
    isPreCloseWindow,
    hasClosedToday: hasClosedToday || alreadyRecordedToday,
  };
}

export function mergeAutoDrawRecord(
  currentHistory: DrawRecord[],
  marketId: string,
  incoming: {
    date: string;
    indexClose: string;
    indexChange: string;
    top3: string;
    top2: string;
    bottom2: string;
  }
): { history: DrawRecord[]; didChange: boolean } {
  const autoId = `${marketId}-auto-${incoming.date}`;
  const existingIdx = currentHistory.findIndex((item) => item.date === incoming.date);

  if (existingIdx !== -1) {
    const existing = currentHistory[existingIdx];
    const isAutoEntry = existing.id.startsWith(`${marketId}-auto-`);
    if (!isAutoEntry) {
      return { history: currentHistory, didChange: false };
    }
    if (
      existing.top3 === incoming.top3 &&
      existing.bottom2 === incoming.bottom2 &&
      existing.indexClose === incoming.indexClose &&
      existing.indexChange === incoming.indexChange
    ) {
      return { history: currentHistory, didChange: false };
    }
    const updated = currentHistory.map((item, idx) =>
      idx === existingIdx
        ? {
            ...item,
            indexClose: incoming.indexClose,
            indexChange: incoming.indexChange,
            top3: incoming.top3,
            top2: incoming.top2,
            bottom2: incoming.bottom2,
          }
        : item
    );
    return { history: updated, didChange: true };
  }

  const nextRecord: DrawRecord = {
    id: autoId,
    date: incoming.date,
    indexClose: incoming.indexClose,
    indexChange: incoming.indexChange,
    top3: incoming.top3,
    top2: incoming.top2,
    bottom2: incoming.bottom2,
  };

  const merged = [nextRecord, ...currentHistory].sort((a, b) =>
    b.date.localeCompare(a.date)
  );
  return { history: merged, didChange: true };
}
import type {
  BacktestDrawOutcome,
  BacktestSummary,
  CalculationStep,
  CustomFormulaSpec,
  DigitPosition,
  DrawRecord,
  FocusedThreeDigitPlan,
  FormulaDefinition,
  FormulaEvaluationContext,
  FormulaResult,
} from '../types/lottery';

export const POSITION_LABELS_TH: Record<DigitPosition, string> = {
  hundredsTop: 'ร้อยบน',
  tensTop: 'สิบบน',
  unitsTop: 'หน่วยบน',
  tensBottom: 'สิบล่าง',
  unitsBottom: 'หน่วยล่าง',
};

export interface ExtractedIndexResult {
  valid: boolean;
  error?: string;
  top3: string;
  top2: string;
  bottom2: string;
  normalizedIndex: string;
  normalizedChange: string;
}

function parseNumericDecimalParts(raw: string): {
  valid: boolean;
  sign: '' | '+' | '-';
  intPart: string;
  decPart: string;
} {
  const cleaned = raw.replace(/[\s,]/g, '').trim();
  if (!cleaned) {
    return { valid: false, sign: '', intPart: '', decPart: '' };
  }
  const match = cleaned.match(/^([+-])?(\d+)(?:\.(\d+))?$/);
  if (!match) {
    return { valid: false, sign: '', intPart: '', decPart: '' };
  }
  const sign = (match[1] as '' | '+' | '-') || '';
  const intPart = match[2];
  const rawDec = match[3] || '';
  const decPart = (rawDec + '00').slice(0, 2);
  return { valid: true, sign, intPart, decPart };
}

export function extractDigitsFromIndex(
  indexClose: string,
  indexChange: string
): ExtractedIndexResult {
  const parsedIndex = parseNumericDecimalParts(indexClose);
  if (!parsedIndex.valid) {
    return {
      valid: false,
      error: 'กรุณากรอกค่าดัชนีปิดตลาดเป็นตัวเลข เช่น 38425.74',
      top3: '',
      top2: '',
      bottom2: '',
      normalizedIndex: '',
      normalizedChange: '',
    };
  }

  const parsedChange = parseNumericDecimalParts(indexChange);
  if (!parsedChange.valid) {
    return {
      valid: false,
      error: 'กรุณากรอกค่าเปลี่ยนแปลงเป็นตัวเลข เช่น +142.38 หรือ -24.15',
      top3: '',
      top2: '',
      bottom2: '',
      normalizedIndex: '',
      normalizedChange: '',
    };
  }

  const lastIntDigit = parsedIndex.intPart.slice(-1);
  const top2 = parsedIndex.decPart;
  const top3 = `${lastIntDigit}${top2}`;
  const bottom2 = parsedChange.decPart;

  const formattedInt = Number(parsedIndex.intPart).toLocaleString('en-US');
  const normalizedIndex = `${formattedInt}.${parsedIndex.decPart}`;
  const changeSign = parsedChange.sign || '+';
  const formattedChangeInt = Number(parsedChange.intPart).toLocaleString('en-US');
  const normalizedChange = `${changeSign}${formattedChangeInt}.${parsedChange.decPart}`;

  return {
    valid: true,
    top3,
    top2,
    bottom2,
    normalizedIndex,
    normalizedChange,
  };
}

export function validateDrawDigits(top3: string, bottom2: string): {
  valid: boolean;
  error?: string;
} {
  if (!/^\d{3}$/.test(top3)) {
    return { valid: false, error: 'เลข 3 ตัวบนต้องเป็นตัวเลข 3 หลัก (000–999)' };
  }
  if (!/^\d{2}$/.test(bottom2)) {
    return { valid: false, error: 'เลข 2 ตัวล่างต้องเป็นตัวเลข 2 หลัก (00–99)' };
  }
  return { valid: true };
}

export function extractPositionDigits(draw: {
  top3: string;
  bottom2: string;
}): Record<DigitPosition, number> {
  const t3 = draw.top3.padStart(3, '0').slice(-3);
  const b2 = draw.bottom2.padStart(2, '0').slice(-2);
  return {
    hundredsTop: Number(t3[0]),
    tensTop: Number(t3[1]),
    unitsTop: Number(t3[2]),
    tensBottom: Number(b2[0]),
    unitsBottom: Number(b2[1]),
  };
}

function mod10(n: number): number {
  return ((n % 10) + 10) % 10;
}

function uniqueDigits(digits: number[]): number[] {
  const seen = new Set<number>();
  const out: number[] = [];
  for (const d of digits) {
    const m = mod10(d);
    if (!seen.has(m)) {
      seen.add(m);
      out.push(m);
    }
  }
  return out;
}

export function evaluateCustomSpec(
  spec: CustomFormulaSpec,
  draw: { top3: string; bottom2: string }
): FormulaResult {
  const pos = extractPositionDigits(draw);
  const termsText: string[] = [];
  let sum = spec.constantOffset;

  for (const term of spec.terms) {
    const val = pos[term.position];
    const prod = val * term.multiplier;
    sum += prod;
    if (term.multiplier === 1) {
      termsText.push(`${POSITION_LABELS_TH[term.position]}(${val})`);
    } else {
      termsText.push(`${POSITION_LABELS_TH[term.position]}(${val})×${term.multiplier}`);
    }
  }

  if (spec.constantOffset !== 0) {
    termsText.push(`คงที่(${spec.constantOffset >= 0 ? `+${spec.constantOffset}` : spec.constantOffset})`);
  }

  const baseDigit = mod10(sum);
  const derived = [baseDigit, ...spec.secondaryOffsets.map((off) => mod10(baseDigit + off))];
  const keyDigits = uniqueDigits(derived);

  const steps: CalculationStep[] = [
    {
      label: 'ดึงหลักเลขฐานจากงวดอ้างอิง',
      expression: `บน ${draw.top3} / ล่าง ${draw.bottom2}`,
      result: `ร้อย=${pos.hundredsTop}, สิบ=${pos.tensTop}, หน่วย=${pos.unitsTop} | สิบล่าง=${pos.tensBottom}, หน่วยล่าง=${pos.unitsBottom}`,
    },
    {
      label: 'คำนวณผลรวมตามน้ำหนักสูตร',
      expression: termsText.length > 0 ? `${termsText.join(' + ')} = ${sum}` : `${sum}`,
      result: `หลักหน่วยฐาน = ${baseDigit}`,
    },
    {
      label: 'แตกเลขเด่นประจำงวด',
      expression:
        spec.secondaryOffsets.length > 0
          ? `${baseDigit} และบวกเพิ่ม ${spec.secondaryOffsets.map((o) => `+${o}`).join(', ')}`
          : `ใช้เลขเด่นตัวเดียว`,
      result: keyDigits.join(' - '),
    },
  ];

  return {
    keyDigits,
    primaryDigit: keyDigits[0],
    steps,
  };
}

export function buildCustomRuleText(spec: CustomFormulaSpec): string {
  const parts = spec.terms.map((t) =>
    t.multiplier === 1
      ? POSITION_LABELS_TH[t.position]
      : `${POSITION_LABELS_TH[t.position]}×${t.multiplier}`
  );
  if (spec.constantOffset !== 0) {
    parts.push(`${spec.constantOffset > 0 ? '+' : ''}${spec.constantOffset}`);
  }
  const offsetNote =
    spec.secondaryOffsets.length > 0
      ? ` (เพิ่ม ${spec.secondaryOffsets.map((o) => `+${o}`).join(', ')})`
      : '';
  return `${parts.join(' + ')} เอาหลักหน่วย${offsetNote}`;
}

export function createFormulaFromSpec(
  id: string,
  name: string,
  summary: string,
  spec: CustomFormulaSpec,
  isCustom = true
): FormulaDefinition {
  return {
    id,
    name,
    summary,
    ruleText: buildCustomRuleText(spec),
    isCustom,
    customSpec: spec,
    evaluate: (draw) => evaluateCustomSpec(spec, draw),
  };
}

