export type MarketRegion = 'thai' | 'asia' | 'europe' | 'americas_me';

export interface DrawRecord {
  id: string;
  date: string; // YYYY-MM-DD
  indexClose: string; // e.g. "38,425.74"
  indexChange: string; // e.g. "+142.38"
  top3: string; // 3 digits e.g. "574"
  top2: string; // 2 digits e.g. "74"
  bottom2: string; // 2 digits e.g. "38"
}

export interface StockMarket {
  id: string;
  nameTh: string;
  nameEn: string;
  indexCode: string;
  sessionTh: string;
  closeTimeTh: string;
  region: MarketRegion;
  regionLabelTh: string;
  defaultHistory: DrawRecord[];
}

export type DigitPosition =
  | 'hundredsTop'
  | 'tensTop'
  | 'unitsTop'
  | 'tensBottom'
  | 'unitsBottom';

export interface FormulaTerm {
  position: DigitPosition;
  multiplier: number;
}

export interface CustomFormulaSpec {
  terms: FormulaTerm[];
  constantOffset: number;
  secondaryOffsets: number[]; // e.g. [1, 3] adds +1 and +3 mod 10 to base digit
}

export interface CalculationStep {
  label: string;
  expression: string;
  result: string;
}

export interface FormulaResult {
  keyDigits: number[];
  primaryDigit: number;
  steps: CalculationStep[];
}

export interface LivePreCloseQuote {
  indexClose: string;
  indexChange: string;
  top3: string;
  bottom2: string;
  timeLabelTh: string;
}

export interface FormulaEvaluationContext {
  indexChange?: string;
  history?: DrawRecord[];
  livePreClose?: LivePreCloseQuote;
}

export interface FormulaDefinition {
  id: string;
  name: string;
  summary: string;
  ruleText: string;
  isCustom: boolean;
  usesLiveTrend?: boolean;
  customSpec?: CustomFormulaSpec;
  evaluate: (
    draw: { top3: string; bottom2: string },
    context?: FormulaEvaluationContext
  ) => FormulaResult;
}

export interface MarketQuoteItem {
  date: string;
  timeBkk: string;
  indexClose: string;
  indexChange: string;
  top3: string;
  top2: string;
  bottom2: string;
}

export interface MarketQuoteSyncData {
  marketId: string;
  symbol: string;
  live?: MarketQuoteItem;
  closed?: MarketQuoteItem;
}

export interface FocusedThreeDigitPlan {
  hundredsCandidates: number[];
  tensCandidates: number[];
  unitsCandidates: number[];
  focused8: string[];
  positional27: string[];
}

export interface BacktestDrawOutcome {
  drawId: string;
  date: string;
  sourceTop3: string;
  sourceBottom2: string;
  actualTop3: string;
  actualBottom2: string;
  predictedDigits: number[];
  hitTop: boolean;
  hitBottom: boolean;
  isHit: boolean;
  hitStraight27: boolean;
  hitFocused8: boolean;
  matchedPositions: number; // 0..3 positions matched in top-3 positional candidates
}

export interface BacktestSummary {
  formulaId: string;
  totalTested: number;
  hitCount: number;
  hitTopCount: number;
  hitBottomCount: number;
  winRate: number;
  currentStreak: number;
  straight27Hits: number;
  focused8Hits: number;
  positionalAccuracy: number; // percentage of (matchedPositions / (totalTested * 3))
  recentOutcomes: BacktestDrawOutcome[];
}
import type { DrawRecord, StockMarket } from '../types/lottery';
import { extractDigitsFromIndex } from '../utils/formulas';

function makeDraw(
  marketId: string,
  index: number,
  date: string,
  indexClose: string,
  indexChange: string
): DrawRecord {
  const extracted = extractDigitsFromIndex(indexClose, indexChange);
  return {
    id: `${marketId}-seed-${index}`,
    date,
    indexClose: extracted.normalizedIndex,
    indexChange: extracted.normalizedChange,
    top3: extracted.top3,
    top2: extracted.top2,
    bottom2: extracted.bottom2,
  };
}

function makeThaiDraw(
  index: number,
  date: string,
  top3: string,
  bottom2: string
): DrawRecord {
  return {
    id: `thai-gov-seed-${index}`,
    date,
    indexClose: 'สลากกินแบ่งรัฐบาล',
    indexChange: '-',
    top3,
    top2: top3.slice(1),
    bottom2,
  };
}

