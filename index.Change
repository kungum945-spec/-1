import express from 'express';
import fs from 'fs';
import path from 'path';
import { fileURLToPath } from 'url';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

const PORT = Number(process.env.PORT) || 3000;
const BANGKOK_OFFSET_MS = 7 * 60 * 60 * 1000;
const CACHE_TTL_MS = 45 * 1000;

interface MarketFeedConfig {
  marketId: string;
  symbol: string;
  closeHour: number;
  closeMinute: number;
  isIntradayCutoff?: boolean;
}

const MARKET_FEEDS: MarketFeedConfig[] = [
  { marketId: 'nikkei-am', symbol: '^N225', closeHour: 9, closeMinute: 30, isIntradayCutoff: true },
  { marketId: 'nikkei-pm', symbol: '^N225', closeHour: 13, closeMinute: 0 },
  { marketId: 'china-am', symbol: '000001.SS', closeHour: 10, closeMinute: 30, isIntradayCutoff: true },
  { marketId: 'china-pm', symbol: '000001.SS', closeHour: 14, closeMinute: 0 },
  { marketId: 'hangseng-am', symbol: '^HSI', closeHour: 11, closeMinute: 0, isIntradayCutoff: true },
  { marketId: 'hangseng-pm', symbol: '^HSI', closeHour: 15, closeMinute: 0 },
  { marketId: 'taiwan', symbol: '^TWII', closeHour: 12, closeMinute: 30 },
  { marketId: 'korea', symbol: '^KS11', closeHour: 13, closeMinute: 0 },
  { marketId: 'singapore', symbol: '^STI', closeHour: 16, closeMinute: 0 },
  { marketId: 'india', symbol: '^BSESN', closeHour: 17, closeMinute: 30 },
  { marketId: 'germany', symbol: '^GDAXI', closeHour: 23, closeMinute: 0 },
  { marketId: 'uk', symbol: '^FTSE', closeHour: 23, closeMinute: 30 },
  { marketId: 'dowjones', symbol: '^DJI', closeHour: 4, closeMinute: 0 },
  { marketId: 'egypt', symbol: '^CASE30', closeHour: 20, closeMinute: 0 },
];

interface QuoteItemPayload {
  date: string;
  timeBkk: string;
  indexClose: string;
  indexChange: string;
  top3: string;
  top2: string;
  bottom2: string;
}

interface MarketSyncPayload {
  marketId: string;
  symbol: string;
  live?: QuoteItemPayload;
  closed?: QuoteItemPayload;
}

interface ParsedBar {
  timestampSec: number;
  dateStr: string;
  timeStr: string;
  minutesOfDay: number;
  close: number;
}

interface SymbolChartData {
  prevClose: number;
  regularMarketPrice: number | null;
  regularMarketTimeSec: number | null;
  bars: ParsedBar[];
}

let quotesCache: { fetchedAt: number; payload: { updatedAt: string; quotes: Record<string, MarketSyncPayload> } } | null = null;

function pad2(n: number): string {
  return String(n).padStart(2, '0');
}

function toBangkokInfo(ms: number): { dateStr: string; timeStr: string; minutesOfDay: number } {
  const bkk = new Date(ms + BANGKOK_OFFSET_MS);
  const y = bkk.getUTCFullYear();
  const m = pad2(bkk.getUTCMonth() + 1);
  const d = pad2(bkk.getUTCDate());
  const hh = bkk.getUTCHours();
  const mm = bkk.getUTCMinutes();
  return {
    dateStr: `${y}-${m}-${d}`,
    timeStr: `${pad2(hh)}:${pad2(mm)}`,
    minutesOfDay: hh * 60 + mm,
  };
}

function buildQuoteDigits(
  price: number,
  prevClose: number,
  dateStr: string,
  timeStr: string
): QuoteItemPayload {
  const roundedPrice = Math.round(price * 100) / 100;
  const priceFixed = roundedPrice.toFixed(2);
  const [priceIntRaw, priceDec] = priceFixed.split('.');
  const priceIntNum = Number(priceIntRaw);
  const indexClose = `${priceIntNum.toLocaleString('en-US')}.${priceDec}`;

  const diff = Math.round((roundedPrice - prevClose) * 100) / 100;
  const sign = diff < 0 ? '-' : '+';
  const absFixed = Math.abs(diff).toFixed(2);
  const [diffIntRaw, diffDec] = absFixed.split('.');
  const diffIntNum = Number(diffIntRaw);
  const indexChange = `${sign}${diffIntNum.toLocaleString('en-US')}.${diffDec}`;

  const top2 = priceDec;
  const top3 = `${priceIntRaw.slice(-1)}${top2}`;
  const bottom2 = diffDec;

  return {
    date: dateStr,
    timeBkk: timeStr,
    indexClose,
    indexChange,
    top3,
    top2,
    bottom2,
  };
}

async function fetchYahooSymbol(symbol: string): Promise<SymbolChartData | null> {
  const url = `https://query1.finance.yahoo.com/v8/finance/chart/${encodeURIComponent(
    symbol
  )}?range=1d&interval=5m`;
  try {
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), 7000);
    const res = await fetch(url, {
      signal: controller.signal,
      headers: {
        'User-Agent': 'Mozilla/5.0 (compatible; StockIndexCalculator/1.0)',
      },
    });
    clearTimeout(timer);
    if (!res.ok) return null;

    const json = (await res.json()) as {
      chart?: {
        result?: Array<{
          meta?: {
            chartPreviousClose?: number;
            previousClose?: number;
            regularMarketPrice?: number;
            regularMarketTime?: number;
          };
          timestamp?: number[];
          indicators?: {
            quote?: Array<{
              close?: Array<number | null>;
            }>;
          };
        }>;
      };
    };

    const result = json.chart?.result?.[0];
    if (!result?.meta) return null;

    const prevClose =
      typeof result.meta.chartPreviousClose === 'number'
        ? result.meta.chartPreviousClose
        : typeof result.meta.previousClose === 'number'
        ? result.meta.previousClose
        : null;

    if (prevClose === null) return null;

    const timestamps = result.timestamp ?? [];
    const closes = result.indicators?.quote?.[0]?.close ?? [];
    const bars: ParsedBar[] = [];

    for (let i = 0; i < timestamps.length; i++) {
      const c = closes[i];
      const t = timestamps[i];
      if (typeof c === 'number' && Number.isFinite(c) && typeof t === 'number') {
        const info = toBangkokInfo(t * 1000);
        bars.push({
          timestampSec: t,
          dateStr: info.dateStr,
          timeStr: info.timeStr,
          minutesOfDay: info.minutesOfDay,
          close: c,
        });
      }
    }

    return {
      prevClose,
      regularMarketPrice:
        typeof result.meta.regularMarketPrice === 'number'
          ? result.meta.regularMarketPrice
          : null,
      regularMarketTimeSec:
        typeof result.meta.regularMarketTime === 'number'
          ? result.meta.regularMarketTime
          : null,
      bars,
    };
  } catch {
    return null;
  }
}

async function computeAllMarketQuotes(force: boolean): Promise<{
  updatedAt: string;
  quotes: Record<string, MarketSyncPayload>;
}> {
  const nowMs = Date.now();
  if (!force && quotesCache && nowMs - quotesCache.fetchedAt < CACHE_TTL_MS) {
    return quotesCache.payload;
  }

  const uniqueSymbols = Array.from(new Set(MARKET_FEEDS.map((m) => m.symbol)));
  const fetchedEntries = await Promise.all(
    uniqueSymbols.map(async (sym) => [sym, await fetchYahooSymbol(sym)] as const)
  );
  const symbolDataMap = new Map<string, SymbolChartData>();
  for (const [sym, data] of fetchedEntries) {
    if (data) symbolDataMap.set(sym, data);
  }

  const nowBkk = toBangkokInfo(nowMs);
  const quotes: Record<string, MarketSyncPayload> = {};

  for (const feed of MARKET_FEEDS) {
    const data = symbolDataMap.get(feed.symbol);
    if (!data) continue;

    const closeMinutes = feed.closeHour * 60 + feed.closeMinute;
    const latestBar = data.bars[data.bars.length - 1];

    const livePrice = data.regularMarketPrice ?? latestBar?.close ?? null;
    const liveTimeInfo = data.regularMarketTimeSec
      ? toBangkokInfo(data.regularMarketTimeSec * 1000)
      : latestBar
      ? { dateStr: latestBar.dateStr, timeStr: latestBar.timeStr, minutesOfDay: latestBar.minutesOfDay }
      : nowBkk;

    const live =
      livePrice !== null
        ? buildQuoteDigits(livePrice, data.prevClose, liveTimeInfo.dateStr, liveTimeInfo.timeStr)
        : undefined;

    let closed: QuoteItemPayload | undefined;
    const sessionDate = latestBar?.dateStr ?? liveTimeInfo.dateStr;
    const dayBars = data.bars.filter((b) => b.dateStr === sessionDate);
    const hasPassedCloseOnSessionDate =
      nowBkk.dateStr > sessionDate ||
      (nowBkk.dateStr === sessionDate && nowBkk.minutesOfDay >= closeMinutes);

    if (hasPassedCloseOnSessionDate && (dayBars.length > 0 || livePrice !== null)) {
      if (feed.isIntradayCutoff) {
        const cutoffBars = dayBars.filter((b) => b.minutesOfDay <= closeMinutes + 5);
        const chosen = cutoffBars[cutoffBars.length - 1];
        if (chosen) {
          closed = buildQuoteDigits(
            chosen.close,
            data.prevClose,
            chosen.dateStr,
            chosen.timeStr
          );
        }
      } else {
        const finalPrice =
          data.regularMarketPrice !== null &&
          liveTimeInfo.dateStr === sessionDate &&
          liveTimeInfo.minutesOfDay >= closeMinutes - 15
            ? data.regularMarketPrice
            : dayBars[dayBars.length - 1]?.close ?? livePrice;

        if (finalPrice !== null) {
          const finalTime = `${pad2(feed.closeHour)}:${pad2(feed.closeMinute)}`;
          closed = buildQuoteDigits(finalPrice, data.prevClose, sessionDate, finalTime);
        }
      }
    }

    quotes[feed.marketId] = {
      marketId: feed.marketId,
      symbol: feed.symbol,
      live,
      closed,
    };
  }

  const payload = {
    updatedAt: new Date(nowMs).toISOString(),
    quotes,
  };
  quotesCache = { fetchedAt: nowMs, payload };
  return payload;
}

async function startServer() {
  const app = express();

  app.get('/api/market-quotes', async (req, res) => {
    const force = req.query.force === '1';
    try {
      const payload = await computeAllMarketQuotes(force);
      res.json(payload);
    } catch {
      res.status(502).json({
        updatedAt: new Date().toISOString(),
        quotes: {},
      });
    }
  });

  if (process.env.NODE_ENV !== 'production') {
    const { createServer: createViteServer } = await import('vite');
    const vite = await createViteServer({
      server: { middlewareMode: true },
      appType: 'spa',
    });
    app.use(vite.middlewares);
  } else {
    const distDir = path.resolve(__dirname, 'dist');
    if (fs.existsSync(distDir)) {
      app.use(express.static(distDir));
      app.get('*', (_req, res) => {
        res.sendFile(path.join(distDir, 'index.html'));
      });
    }
  }

  app.listen(PORT, '0.0.0.0', () => {
    console.log(`Server listening on http://localhost:${PORT}`);
  });
}

startServer();
